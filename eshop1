<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GANAPATHI — Phones that fit your world</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --indigo:#1B1F3B;
    --violet:#6C5CE7;
    --violet-dim:#8A7DF0;
    --sun:#FFC93C;
    --mint:#00C2A8;
    --cloud:#F7F8FC;
    --card:#FFFFFF;
    --ink:#14161F;
    --ink-soft:#5A5F72;
    --line:#E6E8F0;
    --radius:16px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family:'Inter', sans-serif;
    background:var(--cloud);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{ font-family:'Sora', sans-serif; }
  .mono{ font-family:'JetBrains Mono', monospace; }
  a{ color:inherit; text-decoration:none; }
  img{ max-width:100%; display:block; }

  /* ---------- NAV ---------- */
  .nav{
    position:sticky; top:0; z-index:50;
    background:var(--indigo);
    color:#fff;
    padding:14px 28px;
    display:flex; align-items:center; gap:24px;
    box-shadow:0 2px 20px rgba(20,22,31,0.15);
  }
  .logo{
    font-family:'Sora'; font-weight:800; font-size:22px; letter-spacing:0.5px;
    display:flex; align-items:center; gap:8px;
  }
  .logo .dot{ width:9px; height:9px; border-radius:50%; background:var(--sun); display:inline-block; }
  .nav-search{
    flex:1; max-width:420px;
    display:flex; align-items:center;
    background:rgba(255,255,255,0.08);
    border:1px solid rgba(255,255,255,0.14);
    border-radius:999px; padding:8px 16px;
    color:rgba(255,255,255,0.75); font-size:14px;
  }
  .nav-search input{
    background:none; border:none; outline:none; color:#fff; font-family:'Inter'; font-size:14px; flex:1; margin-left:8px;
  }
  .nav-search input::placeholder{ color:rgba(255,255,255,0.5); }
  .nav-right{ margin-left:auto; display:flex; align-items:center; gap:22px; }
  .nav-link{ font-size:14px; font-weight:500; color:rgba(255,255,255,0.85); cursor:pointer; }
  .cart-btn{
    position:relative; display:flex; align-items:center; gap:8px;
    background:var(--violet); padding:9px 16px; border-radius:999px;
    font-size:14px; font-weight:600; cursor:pointer; border:none; color:#fff;
    transition:transform .15s ease, background .15s ease;
  }
  .cart-btn:hover{ background:#7c6ef2; transform:translateY(-1px); }
  .cart-badge{
    background:var(--sun); color:var(--indigo); font-family:'JetBrains Mono';
    font-size:11px; font-weight:600; padding:1px 6px; border-radius:999px; min-width:18px; text-align:center;
  }

  /* ---------- HERO ---------- */
  .hero{
    background:linear-gradient(150deg, var(--indigo) 0%, #262b52 60%, #2c2456 100%);
    color:#fff; padding:64px 28px 84px; position:relative; overflow:hidden;
  }
  .hero-inner{
    max-width:1180px; margin:0 auto; display:grid; grid-template-columns:1.1fr 0.9fr; gap:40px; align-items:center;
  }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono'; font-size:12px;
    color:var(--sun); border:1px solid rgba(255,201,60,0.35); background:rgba(255,201,60,0.08);
    padding:6px 12px; border-radius:999px; margin-bottom:18px;
  }
  .hero h1{ font-size:46px; line-height:1.12; font-weight:800; max-width:560px; }
  .hero p.sub{ margin-top:16px; color:rgba(255,255,255,0.7); font-size:16px; max-width:440px; line-height:1.6; }
  .hero-ctas{ margin-top:30px; display:flex; gap:14px; }
  .btn-primary{
    background:var(--sun); color:var(--indigo); font-weight:700; font-size:14px;
    padding:14px 26px; border-radius:12px; border:none; cursor:pointer;
    transition:transform .15s ease;
  }
  .btn-primary:hover{ transform:translateY(-2px); }
  .btn-ghost{
    background:transparent; color:#fff; font-weight:600; font-size:14px;
    padding:14px 22px; border-radius:12px; border:1px solid rgba(255,255,255,0.25); cursor:pointer;
  }
  .hero-stats{ display:flex; gap:28px; margin-top:40px; }
  .hero-stats div{ font-family:'JetBrains Mono'; }
  .hero-stats .num{ font-size:22px; font-weight:600; color:var(--sun); }
  .hero-stats .label{ font-size:11px; color:rgba(255,255,255,0.55); margin-top:2px; }

  /* Schematic phone illustration */
  .schematic{ position:relative; height:400px; display:flex; align-items:center; justify-content:center; }
  .phone-outline{
    width:190px; height:380px; border-radius:34px; border:2px solid rgba(255,255,255,0.5);
    background:linear-gradient(160deg, rgba(108,92,231,0.35), rgba(255,201,60,0.12));
    position:relative; box-shadow:0 30px 60px rgba(0,0,0,0.35);
  }
  .phone-outline::before{
    content:''; position:absolute; top:16px; left:16px; right:16px; bottom:16px;
    border-radius:22px; background:rgba(20,22,31,0.55); border:1px solid rgba(255,255,255,0.15);
  }
  .callout{
    position:absolute; font-family:'JetBrains Mono'; font-size:11px; color:#fff;
    display:flex; align-items:center; gap:8px; opacity:0; animation:fadeIn .6s ease forwards;
  }
  .callout .tag{
    background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.2);
    padding:4px 9px; border-radius:8px; white-space:nowrap;
  }
  .callout .line{ width:34px; height:1px; background:rgba(255,255,255,0.35); }
  .c1{ top:20px; left:-160px; animation-delay:.3s; }
  .c1 .line{ order:2; }
  .c2{ top:110px; right:-140px; animation-delay:.6s; }
  .c3{ bottom:120px; left:-150px; animation-delay:.9s; }
  .c3 .line{ order:2; }
  .c4{ bottom:30px; right:-120px; animation-delay:1.2s; }
  @keyframes fadeIn{ from{ opacity:0; transform:translateY(6px);} to{ opacity:1; transform:translateY(0);} }
  @media (max-width:900px){ .callout{ display:none; } }

  /* ---------- FILTER BAR ---------- */
  .filter-bar{
    max-width:1180px; margin:0 auto; padding:26px 28px 0;
    display:flex; align-items:center; gap:10px; flex-wrap:wrap;
  }
  .filter-bar .label{ font-size:13px; color:var(--ink-soft); font-weight:600; margin-right:6px; }
  .chip{
    font-size:13px; font-weight:500; padding:8px 16px; border-radius:999px;
    border:1px solid var(--line); background:#fff; cursor:pointer; color:var(--ink-soft);
    transition:all .15s ease;
  }
  .chip.active{ background:var(--indigo); color:#fff; border-color:var(--indigo); }
  .chip:hover{ border-color:var(--violet); color:var(--violet); }
  .chip.active:hover{ color:#fff; }

  /* ---------- PRODUCT GRID ---------- */
  .section-head{ max-width:1180px; margin:44px auto 20px; padding:0 28px; display:flex; align-items:baseline; justify-content:space-between; }
  .section-head h2{ font-size:24px; font-weight:700; }
  .section-head .count{ font-family:'JetBrains Mono'; font-size:12px; color:var(--ink-soft); }

  .grid{
    max-width:1180px; margin:0 auto; padding:0 28px 60px;
    display:grid; grid-template-columns:repeat(4, 1fr); gap:20px;
  }
  @media (max-width:1080px){ .grid{ grid-template-columns:repeat(3,1fr);} .hero-inner{ grid-template-columns:1fr; } .hero{padding-bottom:60px;} }
  @media (max-width:720px){ .grid{ grid-template-columns:repeat(2,1fr);} .hero h1{ font-size:34px; } }
  @media (max-width:480px){ .grid{ grid-template-columns:1fr; } }

  .card{
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
    padding:16px; display:flex; flex-direction:column; position:relative;
    transition:box-shadow .2s ease, transform .2s ease;
  }
  .card:hover{ box-shadow:0 16px 32px rgba(20,22,31,0.08); transform:translateY(-3px); }
  .card .discount-tag{
    position:absolute; top:14px; left:14px; background:var(--mint); color:#fff;
    font-family:'JetBrains Mono'; font-size:11px; font-weight:600; padding:3px 9px; border-radius:7px; z-index:2;
  }
  .device{
    height:150px; border-radius:12px; margin-bottom:14px;
    display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;
  }
  .device .mini-phone{
    width:64px; height:128px; border-radius:12px; border:2px solid rgba(255,255,255,0.6);
    position:relative;
  }
  .device .mini-phone::after{
    content:''; position:absolute; inset:5px; border-radius:7px; background:rgba(255,255,255,0.18);
  }
  .card h3{ font-size:15px; font-weight:600; margin-bottom:6px; }
  .spec-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
  .spec-chips span{
    font-family:'JetBrains Mono'; font-size:10.5px; background:var(--cloud); color:var(--ink-soft);
    padding:3px 8px; border-radius:6px; border:1px solid var(--line);
  }
  .rating{ display:flex; align-items:center; gap:6px; font-size:12px; color:var(--ink-soft); margin-bottom:10px; }
  .rating .stars{ color:var(--sun); letter-spacing:1px; }
  .price-row{ display:flex; align-items:baseline; gap:8px; margin-bottom:14px; }
  .price-row .price{ font-family:'JetBrains Mono'; font-size:18px; font-weight:600; color:var(--ink); }
  .price-row .mrp{ font-family:'JetBrains Mono'; font-size:12px; color:#B3B7C6; text-decoration:line-through; }
  .card-actions{ margin-top:auto; display:flex; gap:8px; align-items:center; }
  .btn-add{
    flex:1; background:#fff; color:var(--violet); font-weight:600; font-size:12.5px;
    padding:10px 0; border-radius:10px; border:1.5px solid var(--violet); cursor:pointer; transition:all .15s ease;
  }
  .btn-add:hover{ background:rgba(108,92,231,0.08); }
  .btn-add.added{ background:var(--mint); color:#fff; border-color:var(--mint); }
  .btn-buy{
    flex:1; background:var(--violet); color:#fff; font-weight:700; font-size:12.5px;
    padding:10px 0; border-radius:10px; border:none; cursor:pointer; transition:background .15s ease;
  }
  .btn-buy:hover{ background:#7c6ef2; }
  .card-actions-row{ display:flex; gap:8px; margin-top:auto; }
  .compare-check{
    display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--ink-soft); cursor:pointer; user-select:none; white-space:nowrap;
    margin-top:10px;
  }
  .compare-check input{ accent-color:var(--violet); width:14px; height:14px; }

  /* ---------- COMPARE TRAY ---------- */
  .compare-tray{
    position:fixed; left:50%; bottom:-100px; transform:translateX(-50%);
    background:var(--indigo); color:#fff; border-radius:16px 16px 0 0;
    padding:14px 20px; display:flex; align-items:center; gap:16px;
    box-shadow:0 -10px 40px rgba(20,22,31,0.25); z-index:60; transition:bottom .3s ease;
    max-width:90vw;
  }
  .compare-tray.show{ bottom:0; }
  .compare-tray .slots{ display:flex; gap:8px; }
  .compare-tray .slot{
    font-family:'JetBrains Mono'; font-size:11.5px; background:rgba(255,255,255,0.08);
    border:1px solid rgba(255,255,255,0.18); padding:6px 10px; border-radius:8px; display:flex; align-items:center; gap:6px;
  }
  .compare-tray .slot button{ background:none; border:none; color:rgba(255,255,255,0.55); cursor:pointer; font-size:13px; }
  .compare-tray .go{
    background:var(--sun); color:var(--indigo); font-weight:700; font-size:13px; border:none;
    padding:10px 18px; border-radius:10px; cursor:pointer; white-space:nowrap;
  }

  /* ---------- CART DRAWER ---------- */
  .overlay{
    position:fixed; inset:0; background:rgba(20,22,31,0.4); opacity:0; pointer-events:none;
    transition:opacity .2s ease; z-index:70;
  }
  .overlay.show{ opacity:1; pointer-events:auto; }
  .drawer{
    position:fixed; top:0; right:-420px; width:400px; max-width:92vw; height:100%;
    background:#fff; z-index:80; transition:right .3s ease; display:flex; flex-direction:column;
    box-shadow:-10px 0 40px rgba(20,22,31,0.2);
  }
  .drawer.show{ right:0; }
  .drawer-head{ padding:22px 22px 16px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; }
  .drawer-head h3{ font-size:18px; font-weight:700; }
  .drawer-head button{ background:none; border:none; font-size:20px; cursor:pointer; color:var(--ink-soft); }
  .drawer-body{ flex:1; overflow-y:auto; padding:16px 22px; }
  .cart-item{ display:flex; gap:12px; padding:14px 0; border-bottom:1px solid var(--line); align-items:center; }
  .cart-item .thumb{ width:48px; height:48px; border-radius:10px; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
  .cart-item .thumb .mp{ width:20px; height:40px; border-radius:5px; border:1.5px solid rgba(255,255,255,0.7); }
  .cart-item .info{ flex:1; }
  .cart-item .info .name{ font-size:13.5px; font-weight:600; }
  .cart-item .info .price{ font-family:'JetBrains Mono'; font-size:12.5px; color:var(--ink-soft); margin-top:2px; }
  .qty{ display:flex; align-items:center; gap:8px; }
  .qty button{ width:22px; height:22px; border-radius:6px; border:1px solid var(--line); background:#fff; cursor:pointer; font-size:13px; }
  .qty span{ font-family:'JetBrains Mono'; font-size:13px; min-width:14px; text-align:center; }
  .remove-btn{ background:none; border:none; color:#C7CAD6; cursor:pointer; font-size:16px; margin-left:6px; }
  .empty-cart{ text-align:center; padding:60px 20px; color:var(--ink-soft); font-size:13.5px; }
  .drawer-foot{ padding:20px 22px; border-top:1px solid var(--line); }
  .total-row{ display:flex; justify-content:space-between; font-family:'JetBrains Mono'; font-size:15px; font-weight:600; margin-bottom:14px; }
  .btn-checkout{ width:100%; background:var(--violet); color:#fff; font-weight:700; font-size:14px; padding:14px 0; border-radius:12px; border:none; cursor:pointer; }
  .btn-checkout:hover{ background:#7c6ef2; }

  /* ---------- COMPARE MODAL ---------- */
  .modal-overlay{
    position:fixed; inset:0; background:rgba(20,22,31,0.5); z-index:90; display:none;
    align-items:center; justify-content:center; padding:20px;
  }
  .modal-overlay.show{ display:flex; }
  .modal{
    background:#fff; border-radius:18px; max-width:800px; width:100%; max-height:85vh; overflow:auto; padding:26px;
  }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; }
  .modal-head h3{ font-size:19px; font-weight:700; }
  .modal-head button{ background:none; border:none; font-size:20px; cursor:pointer; color:var(--ink-soft); }
  table{ width:100%; border-collapse:collapse; font-size:13px; }
  table th, table td{ padding:10px 12px; border-bottom:1px solid var(--line); text-align:left; }
  table th{ font-family:'JetBrains Mono'; font-size:11.5px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.4px; }
  table td.spec-label{ font-family:'JetBrains Mono'; color:var(--ink-soft); font-size:12px; white-space:nowrap; }
  table td.val{ font-weight:600; }

  /* ---------- REVIEWS ---------- */
  .reviews-section{ background:#fff; padding:56px 28px; border-top:1px solid var(--line); }
  .reviews-inner{ max-width:1180px; margin:0 auto; }
  .reviews-head{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:26px; flex-wrap:wrap; gap:10px; }
  .reviews-head h2{ font-size:24px; font-weight:700; }
  .reviews-head .overall{ font-family:'JetBrains Mono'; font-size:13px; color:var(--ink-soft); }
  .reviews-head .overall b{ color:var(--sun); background:var(--indigo); padding:2px 8px; border-radius:6px; margin-right:6px; }
  .review-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  @media (max-width:900px){ .review-grid{ grid-template-columns:1fr; } }
  .review-card{ background:var(--cloud); border:1px solid var(--line); border-radius:14px; padding:20px; }
  .review-card .stars{ color:var(--sun); letter-spacing:2px; font-size:14px; margin-bottom:10px; display:block; }
  .review-card p{ font-size:13.5px; color:var(--ink); line-height:1.6; margin-bottom:14px; }
  .review-card .who{ display:flex; align-items:center; gap:10px; }
  .review-card .avatar{
    width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    color:#fff; font-family:'Sora'; font-weight:700; font-size:13px;
  }
  .review-card .name{ font-size:13px; font-weight:600; }
  .review-card .meta{ font-size:11px; color:var(--ink-soft); font-family:'JetBrains Mono'; }

  /* ---------- CONTACT ---------- */
  .contact-section{ background:var(--indigo); color:#fff; padding:60px 28px; }
  .contact-inner{ max-width:1180px; margin:0 auto; display:grid; grid-template-columns:0.9fr 1.1fr; gap:48px; }
  @media (max-width:800px){ .contact-inner{ grid-template-columns:1fr; } }
  .contact-inner h2{ font-size:26px; font-weight:700; margin-bottom:12px; }
  .contact-inner .sub{ color:rgba(255,255,255,0.65); font-size:14px; line-height:1.6; margin-bottom:26px; max-width:380px; }
  .contact-detail{ display:flex; gap:12px; margin-bottom:16px; font-size:13.5px; }
  .contact-detail .ic{ width:32px; height:32px; border-radius:9px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .contact-detail .txt b{ display:block; margin-bottom:2px; }
  .contact-detail .txt span{ color:rgba(255,255,255,0.6); }
  .contact-form{ background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.14); border-radius:16px; padding:24px; }
  .contact-form .row{ display:flex; gap:12px; margin-bottom:14px; }
  .contact-form label{ display:block; font-size:11.5px; font-family:'JetBrains Mono'; color:rgba(255,255,255,0.55); margin-bottom:6px; }
  .contact-form input, .contact-form textarea{
    width:100%; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.18); border-radius:10px;
    padding:10px 12px; color:#fff; font-family:'Inter'; font-size:13.5px; outline:none;
  }
  .contact-form input::placeholder, .contact-form textarea::placeholder{ color:rgba(255,255,255,0.35); }
  .contact-form textarea{ resize:vertical; min-height:90px; margin-bottom:16px; }
  .contact-form .field{ flex:1; margin-bottom:14px; }
  .btn-send{ background:var(--sun); color:var(--indigo); font-weight:700; font-size:13.5px; padding:12px 24px; border-radius:10px; border:none; cursor:pointer; }
  .btn-send:hover{ transform:translateY(-1px); }

  /* ---------- FOOTER ---------- */
  footer{ background:var(--indigo); color:rgba(255,255,255,0.6); padding:40px 28px; margin-top:40px; }
  footer .foot-inner{ max-width:1180px; margin:0 auto; display:flex; justify-content:space-between; flex-wrap:wrap; gap:20px; font-size:13px; }
  footer .foot-logo{ color:#fff; font-family:'Sora'; font-weight:800; font-size:17px; margin-bottom:8px; }

  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px);
    background:var(--ink); color:#fff; padding:12px 20px; border-radius:10px; font-size:13px;
    opacity:0; pointer-events:none; transition:all .25s ease; z-index:100;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
</style>
</head>
<body>

<nav class="nav">
  <div class="logo"><span class="dot"></span>GANAPATHI</div>
  <div class="nav-search">
    🔍 <input type="text" placeholder="Search phones, brands, specs...">
  </div>
  <div class="nav-right">
    <span class="nav-link" onclick="document.getElementById('shop').scrollIntoView({behavior:'smooth'})">Deals</span>
    <span class="nav-link" onclick="document.getElementById('reviews').scrollIntoView({behavior:'smooth'})">Reviews</span>
    <span class="nav-link" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">Contact us</span>
    <button class="cart-btn" onclick="toggleDrawer(true)">
      🛍 Bag <span class="cart-badge" id="cartCount">0</span>
    </button>
  </div>
</nav>

<section class="hero">
  <div class="hero-inner">
    <div>
      <div class="eyebrow">● MONSOON SALE — up to 35% OFF</div>
      <h1>Find the phone that matches your orbit.</h1>
      <p class="sub">Compare chipsets, cameras, and battery life side by side — then check out in under a minute. No showroom queues, no guesswork.</p>
      <div class="hero-ctas">
        <button class="btn-primary" onclick="document.getElementById('shop').scrollIntoView({behavior:'smooth'})">Shop all phones</button>
        <button class="btn-ghost" onclick="alert('EMI calculator coming soon — starting from ₹999/mo.')">EMI options</button>
      </div>
      <div class="hero-stats">
        <div><div class="num">8</div><div class="label">MODELS IN STOCK</div></div>
        <div><div class="num">24hr</div><div class="label">DELIVERY, METRO CITIES</div></div>
        <div><div class="num">4.6★</div><div class="label">AVG. CUSTOMER RATING</div></div>
      </div>
    </div>
    <div class="schematic">
      <div class="phone-outline"></div>
      <div class="callout c1"><span class="line"></span><span class="tag">108MP · f/1.8</span></div>
      <div class="callout c2"><span class="line"></span><span class="tag">5G · Octa-core</span></div>
      <div class="callout c3"><span class="line"></span><span class="tag">5000mAh · 67W</span></div>
      <div class="callout c4"><span class="line"></span><span class="tag">AMOLED · 120Hz</span></div>
    </div>
  </div>
</section>

<div class="filter-bar">
  <span class="label">Filter:</span>
  <div class="chip active" data-filter="all" onclick="setFilter('all', this)">All phones</div>
  <div class="chip" data-filter="budget" onclick="setFilter('budget', this)">Under ₹15,000</div>
  <div class="chip" data-filter="mid" onclick="setFilter('mid', this)">₹15,000–₹40,000</div>
  <div class="chip" data-filter="premium" onclick="setFilter('premium', this)">₹40,000+</div>
</div>

<div class="section-head" id="shop">
  <h2>Shop phones</h2>
  <span class="count mono" id="resultCount">8 results</span>
</div>

<div class="grid" id="productGrid"></div>

<div class="compare-tray" id="compareTray">
  <span class="mono" style="font-size:12px;color:rgba(255,255,255,0.6);">COMPARE</span>
  <div class="slots" id="compareSlots"></div>
  <button class="go" onclick="openCompareModal()">Compare now →</button>
</div>

<section class="reviews-section" id="reviews">
  <div class="reviews-inner">
    <div class="reviews-head">
      <h2>What customers say</h2>
      <span class="overall"><b>4.6★</b>based on 1,240 verified purchases</span>
    </div>
    <div class="review-grid" id="reviewGrid"></div>
  </div>
</section>

<section class="contact-section" id="contact">
  <div class="contact-inner">
    <div>
      <h2>Get in touch</h2>
      <p class="sub">Questions about a phone, an order, or a warranty claim? Our team replies within one business day.</p>
      <div class="contact-detail">
        <div class="ic">📞</div>
        <div class="txt"><b>Call us</b><span>+91 8939146326 · Mon–Sat, 9am–7pm</span></div>
      </div>
      <div class="contact-detail">
        <div class="ic">✉️</div>
        <div class="txt"><b>Email</b><span>support@ganapathimobile.in</span></div>
      </div>
      <div class="contact-detail">
        <div class="ic">📍</div>
        <div class="txt"><b>Store</b><span>Ganapathi Mobile, Nagercoil, Tamil Nadu</span></div>
      </div>
    </div>
    <form class="contact-form" id="contactForm" onsubmit="submitContact(event)">
      <div class="row">
        <div class="field"><label>Name</label><input type="text" placeholder="Your name" required></div>
        <div class="field"><label>Phone</label><input type="tel" placeholder="Your phone number" required></div>
      </div>
      <div class="field"><label>Email</label><input type="email" placeholder="you@example.com" required></div>
      <label>Message</label>
      <textarea placeholder="How can we help?" required></textarea>
      <button type="submit" class="btn-send">Send message</button>
    </form>
  </div>
</section>

<footer>
  <div class="foot-inner">
    <div>
      <div class="foot-logo">GANAPATHI</div>
      Phones that fit your world.<br>© 2026 Ganapathi Mobile. All rights reserved.
    </div>
    <div>
      <div style="color:#fff;font-weight:600;margin-bottom:8px;">Help</div>
      Track your order<br>Returns &amp; warranty<br>Store locator
    </div>
    <div>
      <div style="color:#fff;font-weight:600;margin-bottom:8px;">Company</div>
      About Ganapathi<br>Careers<br>Press
    </div>
  </div>
</footer>

<!-- Cart Drawer -->
<div class="overlay" id="overlay" onclick="toggleDrawer(false); closeCompareModal();"></div>
<div class="drawer" id="drawer">
  <div class="drawer-head">
    <h3>Your bag</h3>
    <button onclick="toggleDrawer(false)">✕</button>
  </div>
  <div class="drawer-body" id="drawerBody"></div>
  <div class="drawer-foot" id="drawerFoot" style="display:none;">
    <div class="total-row"><span>Total</span><span id="cartTotal">₹0</span></div>
    <button class="btn-checkout" onclick="checkout()">Checkout</button>
  </div>
</div>

<!-- Compare Modal -->
<div class="modal-overlay" id="compareModalOverlay">
  <div class="modal">
    <div class="modal-head">
      <h3>Compare phones</h3>
      <button onclick="closeCompareModal()">✕</button>
    </div>
    <div id="compareTableWrap"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const PALETTE = ['linear-gradient(160deg,#6C5CE7,#8A7DF0)','linear-gradient(160deg,#00C2A8,#3fe0c8)','linear-gradient(160deg,#FFC93C,#ffdd85)','linear-gradient(160deg,#1B1F3B,#3a3f6b)'];

const PRODUCTS = [
  { id:1, name:'Ganapathi Pulse Lite', tier:'budget', ram:'4GB', storage:'64GB', camera:'50MP', battery:'5000mAh', chip:'Helio G88', display:'6.5" IPS 90Hz', price:8499, mrp:9999, rating:4.1, reviews:842, color:2 },
  { id:2, name:'Ganapathi Pulse', tier:'budget', ram:'6GB', storage:'128GB', camera:'50MP', battery:'5000mAh', chip:'Snapdragon 4 Gen2', display:'6.6" AMOLED 90Hz', price:11999, mrp:13999, rating:4.3, reviews:1210, color:1 },
  { id:3, name:'Ganapathi Aria Mini', tier:'budget', ram:'6GB', storage:'128GB', camera:'64MP', battery:'4500mAh', chip:'Dimensity 6100+', display:'6.1" AMOLED 120Hz', price:14499, mrp:16999, rating:4.4, reviews:670, color:0 },
  { id:4, name:'Ganapathi Aria 5G', tier:'mid', ram:'8GB', storage:'128GB', camera:'50MP Triple', battery:'5000mAh', chip:'Snapdragon 6 Gen1', display:'6.7" AMOLED 120Hz', price:18999, mrp:22999, rating:4.5, reviews:2031, color:0 },
  { id:5, name:'Ganapathi Terra Rugged', tier:'mid', ram:'8GB', storage:'128GB', camera:'50MP', battery:'6000mAh', chip:'Dimensity 7050', display:'6.6" IPS 120Hz', price:21999, mrp:24999, rating:4.2, reviews:398, color:1 },
  { id:6, name:'Ganapathi Nova X', tier:'mid', ram:'12GB', storage:'256GB', camera:'108MP Triple', battery:'5000mAh', chip:'Snapdragon 7+ Gen3', display:'6.7" AMOLED 144Hz', price:34999, mrp:39999, rating:4.6, reviews:1875, color:3 },
  { id:7, name:'Ganapathi Nova X Pro Max', tier:'premium', ram:'16GB', storage:'512GB', camera:'200MP Quad', battery:'5500mAh', chip:'Snapdragon 8 Gen3', display:'6.8" AMOLED 165Hz', price:54999, mrp:64999, rating:4.7, reviews:963, color:3 },
  { id:8, name:'Ganapathi Zen Fold', tier:'premium', ram:'12GB', storage:'512GB', camera:'50MP Triple', battery:'4800mAh', chip:'Snapdragon 8 Gen3', display:'7.6" Foldable AMOLED', price:89999, mrp:99999, rating:4.5, reviews:214, color:0 },
];

let cart = {};        // id -> qty
let compareSet = [];  // array of ids, max 3
let currentFilter = 'all';

function fmt(n){ return '₹' + n.toLocaleString('en-IN'); }
function stars(r){ const full = Math.round(r); return '★'.repeat(full) + '☆'.repeat(5-full); }

function renderGrid(){
  const grid = document.getElementById('productGrid');
  const list = PRODUCTS.filter(p => currentFilter==='all' || p.tier===currentFilter);
  document.getElementById('resultCount').textContent = list.length + ' result' + (list.length===1?'':'s');
  grid.innerHTML = list.map(p => {
    const disc = Math.round((1 - p.price/p.mrp)*100);
    const inCart = !!cart[p.id];
    const checked = compareSet.includes(p.id);
    return `
    <div class="card">
      <span class="discount-tag">${disc}% OFF</span>
      <div class="device" style="background:${PALETTE[p.color]}">
        <div class="mini-phone"></div>
      </div>
      <h3>${p.name}</h3>
      <div class="spec-chips">
        <span>${p.ram}/${p.storage}</span>
        <span>${p.camera}</span>
        <span>${p.battery}</span>
      </div>
      <div class="rating"><span class="stars">${stars(p.rating)}</span> ${p.rating} (${p.reviews})</div>
      <div class="price-row">
        <span class="price">${fmt(p.price)}</span>
        <span class="mrp">${fmt(p.mrp)}</span>
      </div>
      <div class="card-actions">
        <div class="card-actions-row">
          <button class="btn-add ${inCart?'added':''}" onclick="addToCart(${p.id})">${inCart? '✓ Added' : 'Add to bag'}</button>
          <button class="btn-buy" onclick="buyNow(${p.id})">Buy now</button>
        </div>
        <label class="compare-check">
          <input type="checkbox" ${checked?'checked':''} onchange="toggleCompare(${p.id}, this)">
          Compare
        </label>
      </div>
    </div>`;
  }).join('');
}

function setFilter(f, el){
  currentFilter = f;
  document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');
  renderGrid();
}

function addToCart(id){
  cart[id] = (cart[id]||0) + 1;
  renderGrid();
  renderCart();
  showToast(PRODUCTS.find(p=>p.id===id).name + ' added to bag');
}
function buyNow(id){
  cart[id] = cart[id] || 1;
  renderGrid();
  renderCart();
  toggleDrawer(true);
}
function changeQty(id, delta){
  if(!cart[id]) return;
  cart[id] += delta;
  if(cart[id] <= 0) delete cart[id];
  renderGrid();
  renderCart();
}
function removeFromCart(id){
  delete cart[id];
  renderGrid();
  renderCart();
}

function renderCart(){
  const ids = Object.keys(cart);
  const countEl = document.getElementById('cartCount');
  const totalQty = ids.reduce((s,id)=>s+cart[id],0);
  countEl.textContent = totalQty;

  const body = document.getElementById('drawerBody');
  const foot = document.getElementById('drawerFoot');
  if(ids.length === 0){
    body.innerHTML = `<div class="empty-cart">Your bag is empty.<br>Add a phone to get started.</div>`;
    foot.style.display = 'none';
    return;
  }
  foot.style.display = 'block';
  let total = 0;
  body.innerHTML = ids.map(id=>{
    const p = PRODUCTS.find(x=>x.id==id);
    const qty = cart[id];
    total += p.price * qty;
    return `
    <div class="cart-item">
      <div class="thumb" style="background:${PALETTE[p.color]}"><div class="mp"></div></div>
      <div class="info">
        <div class="name">${p.name}</div>
        <div class="price">${fmt(p.price)}</div>
      </div>
      <div class="qty">
        <button onclick="changeQty(${p.id},-1)">−</button>
        <span>${qty}</span>
        <button onclick="changeQty(${p.id},1)">+</button>
      </div>
      <button class="remove-btn" onclick="removeFromCart(${p.id})">✕</button>
    </div>`;
  }).join('');
  document.getElementById('cartTotal').textContent = fmt(total);
}

function toggleDrawer(open){
  document.getElementById('drawer').classList.toggle('show', open);
  document.getElementById('overlay').classList.toggle('show', open);
}
function checkout(){
  showToast('This is a demo store — checkout isn\\'t wired up yet.');
}

function toggleCompare(id, checkbox){
  if(checkbox.checked){
    if(compareSet.length >= 3){
      checkbox.checked = false;
      showToast('You can compare up to 3 phones at a time');
      return;
    }
    compareSet.push(id);
  } else {
    compareSet = compareSet.filter(x=>x!==id);
  }
  renderCompareTray();
}
function removeCompare(id){
  compareSet = compareSet.filter(x=>x!==id);
  renderCompareTray();
  renderGrid();
}
function renderCompareTray(){
  const tray = document.getElementById('compareTray');
  const slots = document.getElementById('compareSlots');
  tray.classList.toggle('show', compareSet.length > 0);
  slots.innerHTML = compareSet.map(id=>{
    const p = PRODUCTS.find(x=>x.id===id);
    return `<span class="slot">${p.name}<button onclick="removeCompare(${id})">✕</button></span>`;
  }).join('');
}

function openCompareModal(){
  if(compareSet.length < 2){ showToast('Select at least 2 phones to compare'); return; }
  const phones = compareSet.map(id=>PRODUCTS.find(p=>p.id===id));
  const rows = [
    ['Price', p=>fmt(p.price)],
    ['Chipset', p=>p.chip],
    ['RAM / Storage', p=>p.ram+' / '+p.storage],
    ['Camera', p=>p.camera],
    ['Battery', p=>p.battery],
    ['Display', p=>p.display],
    ['Rating', p=>p.rating+'★ ('+p.reviews+')'],
  ];
  const html = `
  <table>
    <tr><th>Spec</th>${phones.map(p=>`<th>${p.name}</th>`).join('')}</tr>
    ${rows.map(([label, fn])=>`<tr><td class="spec-label">${label}</td>${phones.map(p=>`<td class="val">${fn(p)}</td>`).join('')}</tr>`).join('')}
  </table>`;
  document.getElementById('compareTableWrap').innerHTML = html;
  document.getElementById('compareModalOverlay').classList.add('show');
}
function closeCompareModal(){
  document.getElementById('compareModalOverlay').classList.remove('show');
}

let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2200);
}

renderGrid();
renderCart();
</script>
</body>
</html>
